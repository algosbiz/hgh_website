# Copy this file to .env.local and fill in the values.

# Public URL of the website (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://hghbali.com

# Search engine indexing. Leave empty for staging/preview.
# Set to "enabled" ONLY on the approved production deployment.
SITE_INDEXING=

# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX). Leave empty to disable.
NEXT_PUBLIC_GA_ID=

# Enquiry form email delivery via Resend (https://resend.com)
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=
# Sender must be a domain verified in Resend, e.g. "HGH Bali <enquiries@hghbali.com>"
ENQUIRY_FROM_EMAIL=
